<?xml version="1.0" encoding="utf-8"?>
<!-- Sun/moon dial: half-black disc + rays + slider knob. E-ink friendly: pure black on white, thick strokes. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- rays: three rounded bars at -45/-90/-135 deg around disc centre (54,50) -->
    <group android:translateX="54" android:translateY="50">
        <group android:rotation="-45">
            <path android:fillColor="#000000"
                android:pathData="M -3.5 -33 h 7 a 3 3 0 0 1 3 3 v 6 a 3 3 0 0 1 -3 3 h -7 a 3 3 0 0 1 -3 -3 v -6 a 3 3 0 0 1 3 -3 Z" />
        </group>
        <group android:rotation="-90">
            <path android:fillColor="#000000"
                android:pathData="M -3.5 -33 h 7 a 3 3 0 0 1 3 3 v 6 a 3 3 0 0 1 -3 3 h -7 a 3 3 0 0 1 -3 -3 v -6 a 3 3 0 0 1 3 -3 Z" />
        </group>
        <group android:rotation="-135">
            <path android:fillColor="#000000"
                android:pathData="M -3.5 -33 h 7 a 3 3 0 0 1 3 3 v 6 a 3 3 0 0 1 -3 3 h -7 a 3 3 0 0 1 -3 -3 v -6 a 3 3 0 0 1 3 -3 Z" />
        </group>

        <!-- disc: left half solid black, right half white with heavy outline -->
        <path android:fillColor="#000000"
            android:pathData="M 0 -19 A 19 19 0 0 0 0 19 Z" />
        <path android:fillColor="#FFFFFF"
            android:strokeColor="#000000"
            android:strokeWidth="4"
            android:pathData="M 0 -19 A 19 19 0 0 1 0 19 Z" />
    </group>

    <!-- slider track -->
    <path android:strokeColor="#000000"
        android:strokeWidth="4.5"
        android:strokeLineCap="round"
        android:pathData="M 40 76 H 68" />
    <!-- slider knob -->
    <path android:fillColor="#FFFFFF"
        android:strokeColor="#000000"
        android:strokeWidth="3.5"
        android:pathData="M 46 76 m -6 0 a 6 6 0 1 0 12 0 a 6 6 0 1 0 -12 0 Z" />
</vector>
